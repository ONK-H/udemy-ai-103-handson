# Azure OpenAI / Foundry リソースのエンドポイント
# 形式: https://<resource>.openai.azure.com
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com

# 動画生成モデル(Sora 2 = sora-2)の「デプロイ名」
# 動画生成はプレビュー。sora-2 を Global Standard でデプロイできるのは eastus2 / swedencentral のみ(2026-09-22時点、japaneast不可)。
# コードは openai SDK の videos.create()/retrieve()/download_content() を使う(v1 API)。REST の .../video/generations/jobs 形式は 404 になった(2026-09-22実測)。
# サイズは 720x1280 / 1280x720 / 1024x1792 / 1792x1024 のいずれか(480x480 等は 400 エラー、2026-09-22実測)。
# 警告: 実行すると DeprecationWarning: The Sora API is scheduled to permanently shut down on September 24, 2026. が出た(2026-09-22実測)。
#       Azure の公式な退役スケジュールは sora-2(2025-12-08版)が2026-10-15だが、それより早く止まる可能性がある。廃止後はこのレッスンを実行できません。
AZURE_OPENAI_DEPLOYMENT_NAME=<sora-deployment-name>

# ⚠️ このレッスンには「最下位ティアでの読み替え先」がありません。
#    最下位のクォータティア(Free Tier / Tier 0)には動画生成モデルが含まれていないため、
#    差し替えでは回避できません。加えて動画生成はプレビューで対応リージョンも限られます。
#    実行するには次のどちらかが必要です。
#      ① クォータ増加を申請する → https://aka.ms/oai/stuquotarequest
#      ② 使い続けるうちにティアが自動昇格するのを待つ
#    申請が通るまでは、動画(実践レクチャー)を見て流れを掴む形で進めてください。
#    ジョブ投入から取得までの非同期の流れは動画で確認できます。詳細は FAQ.md を参照。
