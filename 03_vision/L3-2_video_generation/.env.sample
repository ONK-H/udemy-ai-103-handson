# 接続先: Foundry リソースの /openai/v1/（README 手順7で表示した URL を貼る）
# 形式: https://<リソース名>.openai.azure.com/openai/v1/
FOUNDRY_OPENAI_BASE_URL=

# 動画生成モデルのデプロイ名（README 手順5）
VIDEO_MODEL=sora-2

# 出力のサイズと長さ（講座の検証で通った値: サイズ 720x1280 / 1280x720 / 1024x1792 / 1792x1024、長さ 4 / 8 / 12）
VIDEO_SIZE=1280x720
VIDEO_SECONDS=4
