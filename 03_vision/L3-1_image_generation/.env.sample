# 画像生成用に作った Foundry リソースの OpenAI 互換エンドポイント（README 手順6で取得して貼る）
# 形式: https://<resource-name>.openai.azure.com/openai/v1/
# ⚠️ プロジェクトのエンドポイント（.../api/projects/<name>）では画像の生成・編集が 404 になるため、
#    このレッスンはリソースのエンドポイントを直接使います。
FOUNDRY_OPENAI_BASE_URL=

# 画像生成モデルの「デプロイ名」（README 手順3で付けた名前。カタログ名ではない）
IMAGE_MODEL=gpt-image-2
