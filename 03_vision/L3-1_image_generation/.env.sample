# Microsoft Foundry リソースの OpenAI 互換エンドポイント（画像生成用に作ったリソースのもの）
# 形式: https://<resource-name>.openai.azure.com/openai/v1/
#   （.services.ai.azure.com/openai/v1/ でも可）
# ⚠️ プロジェクトのエンドポイント（.../api/projects/<name>）では画像の生成・編集が 404 になるため、
#    このレッスンだけはリソースのエンドポイントを使います（L1-5 の直接呼び出しと同じ形）。
FOUNDRY_OPENAI_BASE_URL=https://<resource-name>.openai.azure.com/openai/v1/

# 画像生成モデルの「デプロイ名」(基盤モデル名ではなくデプロイ時に付けた名前)
# GPT-image-2 は GA(申請不要)。GPT-image-1/1.5/1-mini は限定アクセスプレビュー(要申請)。
# 旧 DALL-E 3 は 2026-03-04 廃止済みのため使用不可。
# GPT-image-2 を Global Standard でデプロイできるリージョン（2026-09-19 時点）:
#   eastus2 / westus3 / polandcentral / swedencentral / uaenorth（japaneast など APAC は不可）
#   対応リージョンの Foundry リソースを作り、その名前を上の FOUNDRY_OPENAI_BASE_URL に入れてください。
IMAGE_MODEL=gpt-image-2

# ⚠️ このレッスンには「最下位ティアでの読み替え先」がありません。
#    最下位のクォータティア（Free Tier / Tier 0）には画像生成モデルが1つも含まれていないため、
#    差し替えでは回避できません。実行するには次のどちらかが必要です。
#      ① クォータ増加を申請する → https://aka.ms/oai/stuquotarequest
#      ② 使い続けるうちにティアが自動昇格するのを待つ
#    申請が通るまでは、動画（実践レクチャー）を見て流れを掴む形で進めてください。
#    引数・パラメータの意味と結果の読み方は動画で確認できます。詳細は FAQ.md を参照。
