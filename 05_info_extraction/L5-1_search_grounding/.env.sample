# 手順7で <foundry>・<project>・<search> を置き換え、STORAGE_RESOURCE_ID を入れる
SEARCH_ENDPOINT=https://<search>.search.windows.net
SEARCH_INDEX_NAME=l5-1-outdoor
# サンプル文書のストレージ（リソース ID。検索サービスのマネージド ID で読む＝キー不要）
STORAGE_RESOURCE_ID=
BLOB_CONTAINER=l5-1-docs
# 埋め込み（Foundry リソースの Azure OpenAI エンドポイント）
AOAI_ENDPOINT=https://<foundry>.openai.azure.com
AOAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
AOAI_EMBEDDING_DIMENSIONS=3072
# エージェント
PROJECT_ENDPOINT=https://<foundry>.services.ai.azure.com/api/projects/<project>
MODEL_DEPLOYMENT=gpt-5.4
SEARCH_CONNECTION_NAME=l5-1-search
