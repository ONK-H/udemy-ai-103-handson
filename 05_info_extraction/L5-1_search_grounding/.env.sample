# Azure AI Search
SEARCH_ENDPOINT=https://<your-search>.search.windows.net
SEARCH_INDEX_NAME=l5-1-grounding

# サンプル文書を置いた Blob コンテナ（マネージドID読み取り／キーレス）
# ResourceId 形式にすると、検索サービスのマネージドIDで Blob を読む（事前に Storage Blob Data Reader を付与）
BLOB_CONNECTION_STRING=ResourceId=/subscriptions/<sub>/resourceGroups/<rg>/providers/Microsoft.Storage/storageAccounts/<account>;
BLOB_CONTAINER=l5-1-docs

# Azure OpenAI（埋め込み）。Foundry リソースなら https://<resource>.openai.azure.com でよい
#   （検索サービスのマネージドIDに Cognitive Services OpenAI User を付与）
AOAI_ENDPOINT=https://<your-aoai>.openai.azure.com
AOAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
AOAI_EMBEDDING_DIMENSIONS=3072
# デプロイ名がモデル名と異なる場合だけ、カタログのモデル名を指定（skill/vectorizer の modelName に使う）
# AOAI_EMBEDDING_MODEL=text-embedding-3-large

# ▼ insufficient quota でデプロイできない場合のフォールバック
#    最下位のクォータティア（Free Tier / Tier 0）にあるのは text-embedding-3-small です
#    （-large は別物で割り当てが付きません）。上の AOAI_EMBEDDING_DEPLOYMENT／AOAI_EMBEDDING_DIMENSIONS の2行をコメントアウトし、以下を使ってください。
#    ⚠️ 次元数もセットで変えること。3072 は -large 専用で、-small は最大 1536 です。
#       次元を合わせないとインデックス作成が失敗します。
#    ⚠️ 既にインデックスを作成済みの場合は、次元が変わるので作り直しが必要です。
# AOAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
# AOAI_EMBEDDING_DIMENSIONS=1536

# Foundry プロジェクト（エージェント）
PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
MODEL_DEPLOYMENT=gpt-4.1-mini
# Foundry ポータルで作成した Azure AI Search への接続名
SEARCH_CONNECTION_NAME=my-search-connection
