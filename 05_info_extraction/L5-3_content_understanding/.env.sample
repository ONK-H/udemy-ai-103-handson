# Foundry リソースの Content Understanding エンドポイント（README 手順4の URL）
CONTENTUNDERSTANDING_ENDPOINT=https://<your-foundry-resource>.services.ai.azure.com/
# 解析する文書の公開URL（公式サンプルの請求書。自分の Blob SAS URL でも可）
DOCUMENT_URL=https://raw.githubusercontent.com/Azure-Samples/azure-ai-content-understanding-assets/main/document/invoice.pdf
# markdown の保存先
OUTPUT_MD=output.md
# アナライザーが使うモデル（カタログのモデル名。デプロイ名ではない）
CU_COMPLETION_MODEL=gpt-5.4
CU_EMBEDDING_MODEL=text-embedding-3-large
# set_defaults.py が既定に登録する、自分のデプロイ名（この講座ではモデル名と同じ）
CU_COMPLETION_DEPLOYMENT=gpt-5.4
CU_EMBEDDING_DEPLOYMENT=text-embedding-3-large
