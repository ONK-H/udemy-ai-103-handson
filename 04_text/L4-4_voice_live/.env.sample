# Foundry プロジェクトのエンドポイント（プロジェクトのホーム画面からコピー）
PROJECT_ENDPOINT=https://<resource-name>.services.ai.azure.com/api/projects/<project-name>
# Voice Live のエンドポイント（プロジェクトのエンドポイントとはドメインが違う別もの。取り違え注意）
VOICELIVE_ENDPOINT=wss://<resource-name>.services.ai.azure.com/voice-live/realtime

# プロジェクト名（PROJECT_ENDPOINTのURL末尾と同じ値）
PROJECT_NAME=<project-name>
# 作成するエージェントの名前（他のレッスンとぶつからないよう専用の名前にする）
AGENT_NAME=voice-live-demo-agent
# カタログ名ではなく「デプロイ名」
MODEL_DEPLOYMENT_NAME=gpt-5.4-nano
