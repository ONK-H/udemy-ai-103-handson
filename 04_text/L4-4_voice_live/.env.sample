# Foundry プロジェクトのエンドポイント（README 手順3の2行目）。エージェントを作る側
PROJECT_ENDPOINT=
# 講座共通の Foundry リソースの「カスタムドメイン」エンドポイント（README 手順3の1行目）。
# Voice Live と TTS はここにキーレスで接続する。https://<リソース名>.cognitiveservices.azure.com/
VOICELIVE_ENDPOINT=

# 接続するエージェント（手順6で作る）
PROJECT_NAME=ai103-project
AGENT_NAME=ai103-voice-agent
# エージェントに使うチャットモデル（カタログ名ではなく「デプロイ名」）
MODEL_DEPLOYMENT_NAME=gpt-5.4
