# 講座共通の Foundry リソースの「カスタムドメイン」エンドポイント（README 手順3）。
# Speech（STT / TTS）はここにキーレスで接続する。https://<リソース名>.cognitiveservices.azure.com/
SPEECH_ENDPOINT=
# Foundry プロジェクトのエンドポイント（README 手順3）。LLM はこちら。Speech とは宛先が違う
PROJECT_ENDPOINT=
# カタログ名ではなく「デプロイ名」
MODEL_DEPLOYMENT=gpt-5.4

# 入力の音声ファイル（手順6で TTS を使って作る）
INPUT_WAV=input.wav
# 読み上げる声
TTS_VOICE=ja-JP-NanamiNeural
