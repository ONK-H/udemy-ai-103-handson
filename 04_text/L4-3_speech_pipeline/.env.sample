# Speech リソースの「カスタムドメイン」エンドポイント（キーレス認証の前提。ポータルの「キーとエンドポイント」で確認）
SPEECH_ENDPOINT=https://<your-speech-resource>.cognitiveservices.azure.com
# 音声合成（TTS）で使うリージョン（例: japaneast）
SPEECH_REGION=japaneast
# Speech リソースのARMリソースID（サブスクリプションIDを含むため .env はコミットしない）
SPEECH_RESOURCE_ID=/subscriptions/<sub-id>/resourceGroups/<rg>/providers/Microsoft.CognitiveServices/accounts/<speech-resource-name>

# Foundry プロジェクトのエンドポイント（音声とは別サービスなので宛先も別）
PROJECT_ENDPOINT=https://<resource-name>.services.ai.azure.com/api/projects/<project-name>
# カタログ名ではなく「デプロイ名」
MODEL_DEPLOYMENT=gpt-5.4-nano

# 空なら既定のマイクを使う。ファイル名を入れるとそのファイルを入力にする（マイクの無い環境では input.wav を指定）
INPUT_WAV=input.wav
# 読み上げる声
TTS_VOICE=ja-JP-NanamiNeural
