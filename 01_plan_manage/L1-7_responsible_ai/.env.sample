# L1-7 実践: ガードレール＋危険入力のブロック＋安全性評価
# cp .env.sample .env でコピーして値を埋める（.env はコミットしない）

# 講座共通のプロジェクトのエンドポイント（README 手順6で取得）
PROJECT_ENDPOINT=https://<resource-name>.services.ai.azure.com/api/projects/ai103-project
# block_demo.py が既定で使うデプロイ名（カタログ名ではない）
MODEL_DEPLOYMENT=gpt-5.4-nano

# 安全性評価に使うプロジェクト（README 手順14で追記される。Japan East は評価サービスの対象外）
# EVAL_PROJECT_ENDPOINT=https://<eval-resource>.services.ai.azure.com/api/projects/ai103-l17-eval
