# L1-5 実践: キーレス化（DefaultAzureCredential ＋ ロール割り当て）
# このファイルを .env にコピーして値を埋める (.env はコミットしない)

# --- main.py 用 (Foundry プロジェクト / キーレス) ---
# Foundry ポータル(ai.azure.com)でプロジェクトを開いたホーム(Overview)画面の「プロジェクト エンドポイント」
PROJECT_ENDPOINT=https://<resource-name>.services.ai.azure.com/api/projects/<project-name>
MODEL_DEPLOYMENT=gpt-5.4

# ▼ insufficient quota でデプロイできない場合のフォールバック
#    最下位のクォータティア（Free Tier / Tier 0）では gpt-5.4 に割り当てが付きません。
#    上の行をコメントアウトし、以下を使ってください。詳細は FAQ.md を参照。
# MODEL_DEPLOYMENT=gpt-5-mini

# --- keyless_openai_direct.py 用 (Foundry Models リソースエンドポイント) ---
# プロジェクトを経由せず、リソースを直接叩くときのベースURL。末尾は /openai/v1/ まで。
# <resource>.openai.azure.com でも <resource>.services.ai.azure.com でも可。
# リソース名は PROJECT_ENDPOINT の先頭部分と同じなので、そこから組み立てられる。
FOUNDRY_OPENAI_BASE_URL=https://<resource-name>.openai.azure.com/openai/v1/

# 比較用(任意): APIキー。キーレス運用では設定しない（空のまま）。
# README 手順15 では、キーを画面やファイルに出さないよう環境変数 FOUNDRY_API_KEY に入れて比較する
# （環境変数が設定されていれば、この空の行より優先される）。
FOUNDRY_API_KEY=
