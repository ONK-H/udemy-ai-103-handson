# L1-4 実践: クォータ確認 + リトライ + コストタグ
# このファイルを .env にコピーして値を埋める (.env はコミットしない)

# --- retry_demo.py 用 (Foundry プロジェクト / キーレス) ---
PROJECT_ENDPOINT=https://<resource-name>.services.ai.azure.com/api/projects/<project-name>
MODEL_DEPLOYMENT=gpt-5.4

# ▼ insufficient quota でデプロイできない場合のフォールバック
#    最下位のクォータティア（Free Tier / Tier 0）では gpt-5.4 に割り当てが付きません。
#    上の行をコメントアウトし、以下を使ってください。詳細は FAQ.md を参照。
# MODEL_DEPLOYMENT=gpt-5-mini

# --- check_quota.py 用 (ARM REST / Usages・Model Capacities API) ---
# サブスクリプション ID は README 手順1で環境変数 AZURE_SUBSCRIPTION_ID に入れる（画面に出さないため、ここには書かない）
QUOTA_LOCATION=japaneast

# Model Capacities API 用 (任意。デプロイ可能な空き容量を調べたいモデル)
# ※ こちらは「容量を問い合わせる」だけなので、そのモデルのクォータが 0 でもそのまま使えます
#    （むしろ gpt-5.4 のままにしておくと、割り当てゼロの状態を API で確認できて勉強になります）
MODEL_NAME=gpt-5.4
MODEL_VERSION=2026-03-05
MODEL_FORMAT=OpenAI

# 表示の絞り込み（任意）: 全件を見たいときは USAGE_FILTER= と空にする／CAPACITY_ALL=1
# USAGE_FILTER=gpt-5.4
# CAPACITY_ALL=0
