# Microsoft Foundry「プロジェクト」のエンドポイント
# 形式: https://<resource-name>.services.ai.azure.com/api/projects/<project-name>
# 取得元は次のいずれか:
#   - `az cognitiveservices account project create/show` の出力にある
#     properties.endpoints の "AI Foundry API" の値（deploy_model.azcli の手順3）
#   - Bicep の出力 projectEndpoint（deploy_bicep.azcli の手順4）
#     ※ 同じ出力にある foundryEndpoint はアカウント単位なので使えません
#   - ポータルのプロジェクト「エンドポイント」
# ⚠️ `az cognitiveservices account show --query properties.endpoint` は
#    <resource-name>.cognitiveservices.azure.com 形式の「アカウント」エンドポイントなので、
#    ここには使えません（別物です）。
PROJECT_ENDPOINT=

# スモークテストで呼び出すデプロイ名（カタログ名ではなく、デプロイ時に付けた名前）
DEPLOYMENT_NAME=chat

# 認証はキーレス（az login 済みの資格情報を DefaultAzureCredential が使用）。APIキーは不要。
# 必要なロール: 推論には "Foundry User"（README 手順11）、作成には Contributor 以上。
