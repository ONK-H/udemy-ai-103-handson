# L1-6 実践: アプリにトレースを仕込み Application Insights で可視化
# このファイルを .env にコピーして値を埋める (.env はコミットしない)

# README 手順6で取得したプロジェクトのエンドポイント (キーレスで接続)
PROJECT_ENDPOINT=https://<resource-name>.services.ai.azure.com/api/projects/ai103-project
# デプロイ名 (README 手順2の Name 列)
MODEL_DEPLOYMENT=gpt-5.4

# Application Insights の接続文字列はここに書かない。
# コードがプロジェクトの接続 (README 手順5) から取り出す。

# --- (任意) トレース計測の挙動を上書きしたいとき。コード側に既定があるので通常は不要 ---
# GenAI トレース計測の実験フラグ (既定 true)
# AZURE_EXPERIMENTAL_ENABLE_GENAI_TRACING=true
# メッセージ本文を span に記録 (個人情報を含みうる。開発時のみ true、本番は false)
# OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=true
