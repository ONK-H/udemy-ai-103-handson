# L2-1 実践: 履歴つき・ストリーミング表示の CLI チャットアプリ
# このファイルを .env にコピーして値を埋める (.env はコミットしない)

# --- Foundry プロジェクト (キーレス)。ホーム画面の「プロジェクト エンドポイント」 ---
PROJECT_ENDPOINT=https://<resource-name>.services.ai.azure.com/api/projects/<project-name>
MODEL_DEPLOYMENT=gpt-5.4

# ▼ gpt-5.4 をデプロイしていない場合は、自分の環境にあるデプロイ名に置き換える
#    （例：L0-3 の gpt-5.4-nano、最下位のクォータティアなら gpt-4.1-mini）
# MODEL_DEPLOYMENT=gpt-5.4-nano
