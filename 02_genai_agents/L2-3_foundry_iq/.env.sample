# README の手順7で埋める値（接続先はすべてキーレスで使う。キーは書かない）
PROJECT_ENDPOINT=https://<foundry>.services.ai.azure.com/api/projects/<project>
FOUNDRY_OPENAI_ENDPOINT=https://<foundry>.openai.azure.com
SEARCH_ENDPOINT=https://<search>.search.windows.net
STORAGE_RESOURCE_ID=/subscriptions/<sub>/resourceGroups/<rg>/providers/Microsoft.Storage/storageAccounts/<storage>
# 名前は変えなくてよい（README の手順と同じ名前）
KNOWLEDGE_SOURCE_NAME=product-blob-ks
KNOWLEDGE_BASE_NAME=product-kb
PROJECT_CONNECTION_NAME=product-kb-mcp
MODEL_DEPLOYMENT=gpt-5.4
