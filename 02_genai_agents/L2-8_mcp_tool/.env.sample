PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
# MCP ツールはツール対応表で gpt-5.4 が Yes（関数ツールと違い、講座の既定モデルで使える）
MODEL_DEPLOYMENT=gpt-5.4
# MCP サーバーへの認証を持つプロジェクト接続の名前（README の事前準備 B で作成。値は Authorization = Bearer <PAT>）
# PAT そのものはここにも書かない
MCP_CONNECTION_NAME=github-mcp
MCP_SERVER_URL=https://api.githubcopilot.com/mcp
