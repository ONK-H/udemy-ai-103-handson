FOUNDRY_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
# デプロイ名を入れる（モデルのカタログ名ではない）
FOUNDRY_MODEL=gpt-4.1-mini

# ▼ gpt-4o-mini (2024-07-18) は 2026-09 時点で Deprecated（リタイア 2027-04-14）。新規デプロイには使わない。
#    最下位のクォータティア（Free Tier / Tier 0）でも gpt-4.1-mini は使えます。詳細は FAQ.md を参照。
# FOUNDRY_MODEL=gpt-5-mini
